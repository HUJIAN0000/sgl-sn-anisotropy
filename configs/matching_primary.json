{
  "mode": "sgls",
  "sn_type": "pantheon+",
  "algo": "milp",
  "tol_type": "dd",
  "file_paths": {
    "tracer": "data/raw/Pantheon+SH0ES.dat",
    "obj": "data/raw/sgls130.CSV",
    "covariance": "data/raw/Pantheon+SH0ES_STAT+SYS.cov"
  },
  "col_cfg": {
    "tracer_z_col": "zHD",
    "tracer_id_col": "CID",
    "z1_col": "zl",
    "z2_col": "zs",
    "magnitude_col": "m_b_corr",
    "output_cols": [
      "CID",
      "IDSURVEY",
      "zHD",
      "zHEL",
      "zCMB",
      "m_b_corr",
      "m_b_corr_err_DIAG",
      "IS_CALIBRATOR"
    ]
  },
  "params": {
    "wm": 0.3,
    "tol": 0.05,
    "unique_by": "object",
    "formulation": "compact",
    "tie_break": "catalogue_order",
    "tie_cost_tolerance": 1e-12,
    "enforce_tracer_order": true,
    "invalid_rows": "error",
    "covariance_kind": "total",
    "require_covariance": true,
    "check_psd": true,
    "time_limit": 600,
    "plots": false,
    "output_dir": "results/matching/primary"
  }
}
